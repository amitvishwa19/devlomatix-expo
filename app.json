{
  "expo": {
    "name": "Devlomatix",
    "slug": "devlomatix",
    "version": "4.0.0",
    "orientation": "default",
    "icon": "./src/assets/images/app-icon.png",
    "scheme": "devlomatix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devlomatixsolutions.devlomatix",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDKJlN8AeS6QZNL5vZMbOOIWFJ2LkVW81o"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/images/splashscreen-light.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "isAndroidBackgroundLocationEnabled": "Allow App to use your location in the background"
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c31305dc-b6b6-4e27-99d1-69cbb565f7f1"
      }
    },
    "owner": "devlomatix"
  }
}